# Local development: SQLite file inside prisma/
DATABASE_URL="file:./dev.db"

# Hosted deployment: Turso/libSQL
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN="your-database-token"

# Code execution backend:
#   local  — run submissions with this machine's toolchains (python3, node,
#            javac, cc). Default when PISTON_URL is unset. Single-user only.
#   piston — send submissions to a sandboxed Piston instance. Required for
#            hosted/multi-user deployments. Default when PISTON_URL is set.
# EXECUTOR="local"
# PISTON_URL="https://your-piston-instance.example.com/api/v2"
# PISTON_AUTH_TOKEN="your-long-random-token"

# Claude API key used for problem generation and runtime AI guidance.
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_GUIDANCE_MODEL="claude-haiku-4-5"

# Public app origin used to build OAuth callback URLs in deployed environments.
# APP_URL="https://your-codeclimb-domain.example"

# OAuth providers:
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."
# GITHUB_CLIENT_ID="..."
# GITHUB_CLIENT_SECRET="..."
# APPLE_CLIENT_ID="com.example.web"
# APPLE_TEAM_ID="..."
# APPLE_KEY_ID="..."
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
