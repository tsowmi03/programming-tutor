// Prisma schema for CodeClimb.
//
// SQLite is used for local development. For production the same schema works
// with Turso (libSQL) via Prisma driver adapters — see DEPLOYMENT.md.
//
// SQLite does not support native enums or Json columns, so string-typed
// fields below are validated at the application boundary with Zod
// (see src/lib/validation.ts) and JSON payloads are stored as strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique // stored lowercase
  name         String
  passwordHash String? // scrypt:N:r:p:salt:hash (base64url); null for OAuth-only accounts
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  submissions    Submission[]
  lessonProgress LessonProgress[]
}

model OAuthAccount {
  id                String @id @default(cuid())
  provider          String // "google" | "github" | "apple"
  providerAccountId String
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String @id @default(cuid())
  tokenHash String @unique // SHA-256 of the cookie token; raw token never stored
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuthRateLimit {
  id           String    @id @default(cuid())
  action       String
  keyHash      String
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([action, keyHash])
  @@index([blockedUntil])
}

model Problem {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  type        String // "code" | "explanation"
  difficulty  String // "easy" | "medium" | "hard"
  category    String // slug of a category, e.g. "arrays-hashing"
  order       Int     @default(0)
  description String // markdown problem statement
  hints       String  @default("[]") // JSON GuidanceItem[]; legacy string[] supported

  // Code problems only
  signature   String? // JSON FunctionSignature
  testCases   String? // JSON TestCase[]
  starterCode String? // JSON Record<LanguageId, string>
  solutions   String? // JSON Record<LanguageId, string> — reference solutions
  editorial   String? // markdown explanation of the intended approach

  // Explanation problems only
  modelAnswer String? // markdown model answer
  keyPoints   String? // JSON string[] — checklist used for self-assessment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]
}

model Submission {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  // Nullable only for rows created before accounts existed; every new
  // submission sets it. scripts/claim-submissions.ts assigns legacy rows.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind     String // "code" | "explanation"
  language String? // code submissions: a LanguageId, e.g. "python" | "typescript" | "cpp"
  code     String?

  answerText String? // explanation submissions
  selfScore  Int? // 0 = missed, 1 = partial, 2 = got it

  status      String // "passed" | "failed" | "error" | "compile_error" | "self_assessed"
  results     String? // JSON TestResult[]
  passedCount Int?
  totalCount  Int?

  createdAt DateTime @default(now())

  @@index([problemId, createdAt])
  @@index([userId, problemId, createdAt])
}

/**
 * Per-user completion of a course lesson. Course content itself lives in
 * src/content/courses (in-memory, like problems); only progress is persisted.
 * A row exists once a lesson is completed — its absence means "not done".
 */
model LessonProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseSlug String
  lessonSlug String // unique within a course

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, courseSlug, lessonSlug])
  @@index([userId, courseSlug])
}
